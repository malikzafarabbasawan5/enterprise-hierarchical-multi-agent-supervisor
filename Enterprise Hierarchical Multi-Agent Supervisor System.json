    {
      "parameters": {
        "promptType": "define",
        "text": "=You are Sub-Agent C (Deliverable Synthesizer).\n\nTask Assignment:\n{{ $json.synthesis_instructions }}\n\nContext/Request:\n{{ $json.original_request }}\n\nDraft executive deliverable structure in JSON format without markdown:\n{\n  \"agent_type\": \"SYNTHESIS\",\n  \"executive_summary\": \"High level overview statement\",\n  \"action_plan_steps\": [\"Step 1\", \"Step 2\", \"Step 3\"]\n}",
