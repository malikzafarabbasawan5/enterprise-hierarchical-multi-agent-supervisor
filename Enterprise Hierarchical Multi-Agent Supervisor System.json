    {
      "parameters": {
        "jsCode": "let responseText = $input.first().json.output || $input.first().json.text || \"\";\nresponseText = responseText.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\n\nlet qaData = {};\ntry {\n  qaData = JSON.parse(responseText);\n} catch (e) {\n  qaData = {\n    qa_passed: false,\n    qa_score: 0,\n    review_summary: \"Failed to parse QA output\",\n    rejection_reason: \"JSON formatting error during review\"\n  };\n}\n\nconst aggregated = $('05 - Aggregate Sub-Agent Outputs').first().json;\n\nreturn [{\n  json: {\n    ...aggregated,\n    qa: qaData\n  }\n}];"
      },
