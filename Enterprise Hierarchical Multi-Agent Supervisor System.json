    {
      "parameters": {
        "jsCode": "let responseText = $input.first().json.output || $input.first().json.text || \"\";\nresponseText = responseText.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\n\nlet plan = {};\ntry {\n  plan = JSON.parse(responseText);\n} catch (e) {\n  plan = {\n    task_id: \"TASK-8099\",\n    original_request: $('01 - Supervisor Intake Webhook').first().json.body?.request || \"Execute multi-stage analysis\",\n    research_instructions: \"Extract core technical parameters and context.\",\n    analysis_instructions: \"Perform strategic evaluation and risk scoring.\",\n    synthesis_instructions: \"Consolidate findings into enterprise summary.\"\n  };\n}\n\nreturn [{ json: plan }];"
      },
